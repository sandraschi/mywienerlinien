# mywienerlinien — environment template (no secrets; copy to .env and fill in)
# App database: SQLite file (WAL), created on first boot. Full-SQLite cutover:
# the legacy DATABASE_URL/Postgres path is gone (historical rows stay in the
# retired postgres_data Docker volume, not migrated — recreate keys/favorites).
APP_DB_PATH=./data/app.db
APP_ENV=development
WEB_PORT=11170
FRONTEND_PORTS=10896,3079,3080
OPENWEATHER_API_KEY=
# Normalized GTFS snapshot written by gtfs-mcp (<data_dir>/snapshots/<feed>.db).
# Map/line/station reads use this file — no Postgres needed for them.
# Empty = <repo>/../gtfs-mcp/data/snapshots/vienna.db when that file exists.
# GTFS_SNAPSHOT_PATH=
# Per-city gtfs-mcp exports (scripts/gtfs_data/cities/<id>/ + manifest.json).
# Empty = <repo>/scripts/gtfs_data/cities. Drives data_loaded flags in
# GET /api/cities for the city switcher UI.
# MYWIENERLINIEN_GTFS_CITIES=
GRAFANA_PASSWORD=
WIENER_LINIEN_TEST_MODE=
# Shared secret for POST /api/webhooks/inbound (X-Webhook-Secret header).
# Leave empty to disable inbound webhooks (endpoint answers 503).
WEBHOOK_SECRET=
