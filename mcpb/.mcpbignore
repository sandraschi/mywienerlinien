# MCPB ignore file - exclude from package
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
venv/
env/
ENV/
.venv
*.egg-info/
dist/
build/
.git/
.gitignore
*.log
node_modules/
.DS_Store
*.swp
*.swo
*~

# Exclude dependencies - they're installed by MCP client
requirements.txt
pyproject.toml

# Exclude test files
tests/
test_*.py
*_test.py

# Exclude development files
.vscode/
.idea/
*.bak
*.tmp

# Exclude web app specific files (not needed for MCP server)
frontend/app.py
frontend/static/
frontend/templates/
frontend/websocket_manager.py
frontend/gtfs_manager.py
frontend/gtfs_service.py
frontend/disruption_alerts.py
frontend/models/
frontend/scripts/
frontend/data/
frontend/logs/
frontend/db/
frontend/Dockerfile
frontend/docker-compose.yml
frontend/README_Docker.md
frontend/requirements-db.txt
frontend/requirements-mcp.txt
frontend/find_missing_coords.py
frontend/test_*.py

